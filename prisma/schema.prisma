// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

enum JobStatus {
  draft
  scheduled
  running
  completed
  reverted
  failed
}

enum JobMode {
  percent
  fixed
  setvalue
  /// Compare-at = current price + value percent (price unchanged).
  compareAtMarkup
  csv
}

enum JobTargetField {
  price
  compareAtPrice
  both
}

enum JobFilterType {
  collection
  tag
  vendor
  productType
  advanced
  manual
  csv
}

enum JobItemStatus {
  pending
  applied
  reverted
  error
  /// Left alone on revert because its price was changed after this job set
  /// it (by another job or by hand), or the variant no longer exists.
  skipped
  /// Never changed: skipped when the job ran (deleted, or already on sale
  /// with "skip variants already on sale"). Revert never touches these.
  notApplied
}

model PriceJob {
  id                    String         @id @default(cuid())
  shopName              String
  name                  String?
  status                JobStatus      @default(draft)
  mode                  JobMode
  targetField           JobTargetField
  value                 Decimal?       @db.Decimal(12, 4)
  filterType            JobFilterType
  filterValue           String?        @db.Text
  runAt                 DateTime?
  revertAt              DateTime?
  /// Leave variants (and market prices) that already have a compare-at price alone.
  skipExistingCompareAt Boolean        @default(false)
  /// Price rounding style (see Rounding in app/lib/pricing.ts). Null = none.
  rounding              String?        @db.VarChar(8)
  /// Never lower a price below this (base currency).
  minPrice              Decimal?       @db.Decimal(12, 4)
  /// Never lower a price by more than this percent.
  maxDiscountPercent    Decimal?       @db.Decimal(6, 2)
  /// Keep applying this job's rule to products that start matching its
  /// filter later (e.g. products uploaded after a sale started).
  autoApplyNewProducts  Boolean        @default(false)
  /// When the job last checked for newly matching products.
  lastSyncedAt          DateTime?
  /// Product tag added while the job's change is live, removed on revert
  /// (e.g. "black-month-sale", for an automated Sale collection).
  saleTag               String?        @db.VarChar(255)
  /// Set once a scheduled job's prices were recomputed from live prices at
  /// run time, so a resume after a cut-off knows whether to do it.
  pricesRefreshedAt     DateTime?
  /// Set once the job's market fixed prices (e.g. UK GBP) have been read and recorded.
  /// False on jobs that ran before market prices were supported.
  marketPricesRecorded  Boolean        @default(false)
  errorMessage          String?        @db.Text
  createdAt             DateTime       @default(now())
  completedAt           DateTime?
  revertedAt            DateTime?
  items                 PriceJobItem[]

  @@index([shopName, status])
  @@index([status, runAt])
}

model PriceJobItem {
  id                String                @id @default(cuid())
  jobId             String
  job               PriceJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  variantId         String
  productId         String
  sku               String?
  /// Product (and variant) title when the job was created, for price history.
  productTitle      String?               @db.VarChar(512)
  oldPrice          Decimal               @db.Decimal(12, 4)
  newPrice          Decimal               @db.Decimal(12, 4)
  oldCompareAtPrice Decimal?              @db.Decimal(12, 4)
  newCompareAtPrice Decimal?              @db.Decimal(12, 4)
  status            JobItemStatus         @default(pending)
  errorMessage      String?               @db.Text
  /// This job added its sale tag to the product (it didn't have it before),
  /// so revert may remove it again.
  taggedByJob       Boolean               @default(false)
  marketPrices      PriceJobMarketPrice[]

  @@index([jobId])
  @@index([variantId])
  @@index([sku])
}

/// A variant's fixed price in a market price list (e.g. the UK market's GBP
/// price). Fixed prices override the base price in that market, so they have
/// to be changed (and reverted) alongside it.
model PriceJobMarketPrice {
  id                String        @id @default(cuid())
  itemId            String
  item              PriceJobItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceListId       String
  marketName        String
  currency          String
  oldPrice          Decimal       @db.Decimal(12, 4)
  newPrice          Decimal       @db.Decimal(12, 4)
  oldCompareAtPrice Decimal?      @db.Decimal(12, 4)
  newCompareAtPrice Decimal?      @db.Decimal(12, 4)
  status            JobItemStatus @default(pending)
  errorMessage      String?       @db.Text

  @@index([itemId])
}
